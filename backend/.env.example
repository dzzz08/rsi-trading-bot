# ZardoshtiOS — Market Intelligence (Morning Briefing) backend config.
# Copy to .env and adjust. The MVP runs fully on defaults (mock everything).

NODE_ENV=development
PORT=4000

# --- Adapter selection (mock↔real is a config change) ------------------------
# DATA_SOURCE: mock = deterministic offline data | real = live providers (keys req'd)
DATA_SOURCE=mock
# LLM_PROVIDER: mock = deterministic analyst | anthropic = real Claude call
LLM_PROVIDER=mock
# PERSISTENCE: memory = in-process | postgres = DATABASE_URL required
PERSISTENCE=memory
# DELIVERY_CHANNEL: the app is the delivery surface — in_app (default) makes the
# briefing available in the dashboard/API. console prints it (dev). email/telegram/
# discord are optional additive adapters, not required.
DELIVERY_CHANNEL=in_app

# --- LLM (required when LLM_PROVIDER=anthropic) ------------------------------
ANTHROPIC_API_KEY=
# Default analyst model; claude-opus-4-8 available for higher-stakes runs.
LLM_MODEL=claude-sonnet-4-6

# --- Real data providers (required when DATA_SOURCE=real) --------------------
TWELVE_DATA_API_KEY=
MARKETAUX_API_KEY=
TRADING_ECONOMICS_API_KEY=

# --- Persistence (required when PERSISTENCE=postgres) ------------------------
DATABASE_URL=

# --- Auth & scheduling ------------------------------------------------------
# Operator bearer token for the API (change for any non-local use).
API_BEARER_TOKEN=dev-operator-token
# Separate token guarding the internal generate trigger.
SCHEDULER_TOKEN=dev-scheduler-token
# In-process morning cron (false by default; an external scheduler can drive
# POST /api/v1/internal/briefings/generate instead).
ENABLE_CRON=false
BRIEFING_CRON=30 5 * * *
CRON_TIMEZONE=Europe/London

# Throw on guardrail violations (recommended true with a real LLM).
STRICT_GUARD=false
